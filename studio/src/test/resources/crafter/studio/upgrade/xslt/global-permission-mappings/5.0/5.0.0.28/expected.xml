<permissions>
	<role name="system_admin">
		<rule regex="/.*">
			<allowed-permissions>
				<permission>content_read</permission>
				<permission>content_write</permission>
				<permission>content_delete</permission>
				<permission>content_move</permission>
			</allowed-permissions>
		</rule>
	</role>
	<role name="site_admin">
		<rule regex="/.*">
			<allowed-permissions>
				<permission>audit_log</permission>
			</allowed-permissions>
		</rule>
	</role>
	<role name="custom_writer">
		<rule regex="/site/.*">
			<allowed-permissions>
				<permission>content_write</permission>
				<permission>content_move</permission>
			</allowed-permissions>
		</rule>
	</role>
</permissions>
