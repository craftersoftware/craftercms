<site-config>
	<version>5.0.0.0</version>
	<wem-project>old-project</wem-project>
	<custom-site-flag>keep-site-flag</custom-site-flag>
	<display-name>Custom Site</display-name>
	<site-urls>
		<authoring-url>https://author.example</authoring-url>
		<staging-url>https://staging.example</staging-url>
		<live-url>https://live.example</live-url>
		<preview-url>https://preview.example</preview-url>
	</site-urls>
	<repository rootPrefix="/site" custom-root="kept">
		<level-descriptor>crafter-level-descriptor.level.xml</level-descriptor>
		<custom-before-folders>keep-before-folders</custom-before-folders>
		<folders>
			<folder name="Pages" path="/website" read-direct-children="false" attach-root-prefix="true"/>
			<folder name="Custom" path="/custom" read-direct-children="true" attach-root-prefix="false">
				<note>nested-custom-removed-with-folders</note>
			</folder>
			<custom-folder-child>also-removed</custom-folder-child>
		</folders>
		<custom-after-folders>keep-after-folders</custom-after-folders>
		<patterns>
			<pattern-group name="component">
				<pattern>/site/components/([^&lt;]+)\.xml</pattern>
				<pattern>/site/items/([^&lt;]+)\.xml</pattern>
			</pattern-group>
			<pattern-group name="acme-type">
				<pattern>/site/acme/([^&lt;]+)\.xml</pattern>
			</pattern-group>
			<pattern-group name="previewable-mimetypes">
				<pattern>image/(.*)</pattern>
				<pattern>custom/should-be-removed</pattern>
			</pattern-group>
			<pattern-group name="document">
				<pattern>/documents/([^&lt;]+)\.pdf</pattern>
			</pattern-group>
		</patterns>
		<display-in-widget-patterns>
			<display-in-widget-pattern>.*</display-in-widget-pattern>
			<display-in-widget-pattern>/site/custom/.*</display-in-widget-pattern>
		</display-in-widget-patterns>
		<custom-widget-sibling>keep-widget-sibling</custom-widget-sibling>
	</repository>
	<remoteGitBranch>feature/custom</remoteGitBranch>
</site-config>
