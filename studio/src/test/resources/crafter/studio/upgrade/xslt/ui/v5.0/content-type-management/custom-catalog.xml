<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ A site that already defined its own top-level ContentTypeManagement catalog.
  -->
<siteUi>
    <version>4.5.0.0</version>
    <widget id="craftercms.components.TinyMCE">
        <configuration>
            <setups>
                <setup id="generic">
                    <tinymceOptions><![CDATA[
                {
                    "toolbar1": "blocks | bold",
                    "autoresize_on_init": false,
                    "autoresize_bottom_margin": 0
                }
            ]]></tinymceOptions>
                </setup>
            </setups>
        </configuration>
    </widget>
    <widget id="craftercms.components.ContentTypeManagement">
        <configuration>
            <controls>
                <control id="input">
                    <icon id="acme.icons.CustomInput"/>
                </control>
                <control id="acme-custom">
                    <icon id="acme.icons.Custom"/>
                </control>
            </controls>
            <dataSources>
                <dataSource id="components">
                    <icon id="acme.icons.Components"/>
                </dataSource>
            </dataSources>
        </configuration>
    </widget>
    <widget id="craftercms.components.CustomSiteWidget">
        <configuration>
            <keep>still-here</keep>
        </configuration>
    </widget>
</siteUi>
