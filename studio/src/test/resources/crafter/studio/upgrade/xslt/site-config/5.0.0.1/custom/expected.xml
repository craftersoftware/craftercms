<site-config>
	<version>5.0.0.0</version>
	<custom-site-flag>keep-site-flag</custom-site-flag>
	<display-name>Custom Site</display-name>
	<site-urls>
		<authoring-url>https://author.example</authoring-url>
		<live-url>https://live.example</live-url>
		<preview-url>https://preview.example</preview-url>
	</site-urls>
	<repository custom-root="kept">
		<level-descriptor>crafter-level-descriptor.level.xml</level-descriptor>
		<custom-before-folders>keep-before-folders</custom-before-folders>
		<custom-after-folders>keep-after-folders</custom-after-folders>
		<patterns>
			<pattern-group name="component">
				<pattern>/site/components/([^&lt;]+)\.xml</pattern>
				<pattern>/site/items/([^&lt;]+)\.xml</pattern>
			</pattern-group>
			<pattern-group name="acme-type">
				<pattern>/site/acme/([^&lt;]+)\.xml</pattern>
			</pattern-group>
			<pattern-group name="document">
				<pattern>/documents/([^&lt;]+)\.pdf</pattern>
			</pattern-group>
		</patterns>
		<custom-widget-sibling>keep-widget-sibling</custom-widget-sibling>
	</repository>
	<remoteGitBranch>feature/custom</remoteGitBranch>
</site-config>
