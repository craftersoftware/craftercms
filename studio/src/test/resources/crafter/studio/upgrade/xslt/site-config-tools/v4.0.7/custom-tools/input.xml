<config>
	<version>4.0.6</version>
	<tools>
		<tool>
			<name>custom-site-tool</name>
			<label>Custom Site Tool</label>
			<icon>
				<class>fa-wrench</class>
			</icon>
		</tool>
		<tool>
			<name>content-types</name>
			<label>Content Types</label>
			<controls>
				<control>
					<name>input</name>
				</control>
				<control>
					<name>my-plugin-control</name>
					<plugin>
						<type>form-control</type>
						<name>my-plugin-control</name>
					</plugin>
				</control>
			</controls>
			<datasources>
				<datasource>
					<name>img-desktop-upload</name>
				</datasource>
				<datasource>
					<name>my-plugin-datasource</name>
					<plugin>
						<type>form-datasource</type>
						<name>my-plugin-datasource</name>
					</plugin>
				</datasource>
			</datasources>
		</tool>
		<tool>
			<name>encrypt-tool</name>
			<label>Encryption Tool</label>
			<icon>
				<class>fa-lock</class>
			</icon>
		</tool>
	</tools>
</config>
