{
  "name": "@craftercms/sdk",
  "version": "4.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Crafter CMS SDK for JavaScript",
  "scripts": {
    "build": "./build.sh",
    "prettier:all": "prettier -w packages/*/src/**/*.ts prettier -w packages/*/test/**/*.ts",
    "prettier:packages": "prettier -w packages/*/src/**/*.ts",
    "prettier:tests": "prettier -w packages/*/test/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftersoftware/craftercms.git",
    "directory": "js-sdk"
  },
  "keywords": [
    "content",
    "mananagement",
    "crafter",
    "craftercms"
  ],
  "author": "CrafterCMS",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/craftersoftware/craftercms/issues"
  },
  "homepage": "https://github.com/craftersoftware/craftercms/tree/develop/js-sdk#readme",
  "devDependencies": {
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.0.2"
}
