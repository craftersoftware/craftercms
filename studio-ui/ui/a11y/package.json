{
	"name": "@craftercms/studio-a11y",
	"description": "Automated accessibility (axe) checks for Studio screens.",
	"private": true,
	"license": "LGPL-3.0-only",
	"scripts": {
		"test": "playwright test --project=light --project=dark",
		"test:light": "playwright test --project=light",
		"test:dark": "playwright test --project=dark",
		"test:unit": "playwright test --project=unit",
		"capture": "A11Y_CAPTURE=1 playwright test --project=light --project=dark",
		"report": "playwright show-report report/html",
		"browsers": "playwright install chromium",
		"compile": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"typescript": "^7.0.2"
	}
}
