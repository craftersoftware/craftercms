{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./build_tsc",
		"module": "esnext",
		"target": "ES2022",
		"importHelpers": true,
		"composite": true,
		"paths": {
			"react": ["../../node_modules/react"],
			"@craftercms/studio-ui": ["../app/src"],
			"@craftercms/studio-ui/*": ["../app/src/*"]
		}
	},
	"references": [
		{
			"path": "../app/tsconfig.build.json"
		}
	],
	"include": ["./src", "src/**/*.json"],
	"exclude": ["./src/hooks.bak.ts", "node_modules", "./src/jquery", "src/**/*.test.ts"]
}
