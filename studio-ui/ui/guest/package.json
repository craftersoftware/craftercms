{
	"name": "@craftercms/experience-builder",
	"description": "CrafterCMS' Experience Builder integration sdk.",
	"version": "4.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/craftercms/studio-ui.git",
		"directory": "ui/guest/src"
	},
	"private": true,
	"main": "build_tsc/node/index.js",
	"module": "build_tsc/index.js",
	"typings": "build_tsc/index.d.ts",
	"craftercms": {
		"id": "craftercms.guest"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"bic": {
		"skip": [
			"build",
			"build_tsc",
			"README.md",
			"CHANGE_LOG.md"
		]
	},
	"scripts": {
		"build": "rollup -c",
		"start": "rollup -c -w",
		"watch": "rollup -c -w",
		"build:modern": "tsc --build tsconfig.json",
		"clean:npm": "rimraf ./build_tsc ./tsconfig.tsbuildinfo",
		"build:node": "tsc --build tsconfig.node.json",
		"create-package-file": "node ./scripts/package.js",
		"replace-env-version": "node ./scripts/replaceEnvVersion.js",
		"build:npm": "run-s clean:npm build:modern replace-env-version create-package-file copy-jquery-npm",
		"copy-jquery-npm": "cp -r ./src/jquery ./build_tsc/jquery",
		"bom": "mkdir -p target && yarn cyclonedx --output-file target/bom.json",
		"lint": "eslint .",
		"i18n:extract": "formatjs extract './src/**/*.{ts,tsx}' --ignore='**/*.d.ts' --out-file src/translations/en-extract.json"
	},
	"dependencies": {
		"@craftercms/classes": "4.4.0",
		"@craftercms/content": "4.4.2",
		"@craftercms/ice": "4.3.1",
		"@craftercms/npm-content": "workspace:^",
		"@craftercms/search": "4.3.0",
		"@craftercms/studio-ui": "workspace:^",
		"@emotion/css": "^11.13.5",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@rollup/plugin-alias": "^6.0.0",
		"@types/react-dom": "^19.2.3",
		"js-cookie": "^3.0.5",
		"prop-types": "^15.8.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hotkeys-hook": "^5.2.4",
		"react-intl": "^10.1.25",
		"react-is": "^19.2.4",
		"react-redux": "^9.2.0",
		"redux": "^5.0.1",
		"redux-observable": "^3.0.0-rc.3",
		"rxjs": "^7.8.2",
		"typescript": "^7.0.2",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.13.1",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-swc": "^0.4.0",
		"@swc/core": "^1.15.18",
		"@types/jquery": "^4.0.1",
		"@types/js-cookie": "^3.0.6",
		"@types/prop-types": "^15.7.15",
		"@types/react-is": "^19.2.0",
		"build-if-changed": "^1.5.5",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.15",
		"replace-in-file": "^9.0.0",
		"rimraf": "^6.1.3",
		"rollup": "^4.59.0",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-svg": "^2.0.0",
		"rollup-plugin-swc3": "^0.12.1",
		"yargs": "^18.0.0"
	},
	"type": "module"
}
