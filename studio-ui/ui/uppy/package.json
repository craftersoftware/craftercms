{
	"name": "@craftercms/uppy",
	"description": "CrafterCMS UI Uppy extensions.",
	"version": "4.2.0",
	"license": "MIT",
	"main": "lib/index.js",
	"types": "types/index.d.ts",
	"keywords": [
		"file uploader",
		"uppy",
		"uppy-plugin",
		"dashboard",
		"xhr",
		"craftercms"
	],
	"homepage": "https://craftercms.com",
	"bugs": {
		"url": "https://github.com/craftersoftware/craftercms/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/craftercms/studio-ui.git",
		"directory": "ui/uppy"
	},
	"bic": {
		"skip": [
			"lib",
			".gitignore",
			"README.md"
		]
	},
	"scripts": {
		"build": "babel src -d lib",
		"watch": "babel src -d lib --watch",
		"bom": "mkdir -p target && yarn cyclonedx --output-file target/bom.json"
	},
	"dependencies": {
		"@transloadit/prettier-bytes": "^1.1.0",
		"classnames": "^2.5.1",
		"preact": "^10.29.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.6",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-object-rest-spread": "^7.20.7",
		"@babel/plugin-transform-private-methods": "^7.28.6",
		"@babel/plugin-transform-react-jsx": "^7.28.6",
		"@babel/preset-env": "^7.29.0",
		"@babel/preset-react": "^7.28.5",
		"@types/babel__preset-env": "^7.10.0",
		"@types/eslint": "^9.6.1",
		"babel-plugin-inline-package-json": "^2.0.0",
		"build-if-changed": "^1.5.5",
		"eslint": "^10.0.3"
	},
	"peerDependencies": {
		"uppy": "^5.2.3"
	},
	"files": [
		"lib/*",
		"types/*"
	]
}
