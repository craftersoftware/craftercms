{
	"name": "@craftercms/npm-content",
	"version": "1.0.0",
	"main": "index.js",
	"author": "Roy Art",
	"license": "LGPL-3.0-only",
	"private": true,
	"bic": {
		"skip": [
			"build",
			"README.md",
			"CHANGE_LOG.md"
		]
	},
	"scripts": {
		"build": "chmod +x build.sh; ./build.sh",
		"build:monaco": "webpack --config ./src/monaco/webpack.config.js",
		"build:jquery": "grunt --base ./jquery-src --gruntfile ./jquery-src/Gruntfile.js custom:-ajax,-css,-deprecated,-dimensions,-effects,-event/trigger,-offset,-wrap,-core/ready,-deferred,-selector",
		"bom": "mkdir -p target && yarn cyclonedx --output-file target/bom.json"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"ace-builds": "^1.43.6",
		"bootstrap": "^5.3.8",
		"css-loader": "^7.1.4",
		"file-loader": "^6.2.0",
		"jquery": "^3.7.1",
		"jquery-ui": "^1.14.2",
		"jquery-ui-css": "^1.11.5",
		"js-yaml": "^5.2.2",
		"monaco-editor": "0.54.0",
		"style-loader": "^4.0.0",
		"tinymce": "^8.3.2"
	},
	"devDependencies": {
		"@types/bootstrap": "^5.2.10",
		"@types/jquery": "^3.5.34",
		"@types/rimraf": "^4.0.5",
		"build-if-changed": "^1.5.5",
		"grunt": "^1.6.1",
		"monaco-editor-webpack-plugin": "^7.1.1",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.1.3",
		"webpack": "^5.105.4",
		"webpack-cli": "^6.0.1"
	}
}
